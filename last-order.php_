<?php
// last-order.php
// Jetinno Orders parser (EN/TR layouts).
// Sends Telegram: PayType, VMC, Location, Drink, Price.
// Does NOT send OrderNo, but uses it for deduplication and stores in txt.
//
// Requirements: functions.php already included (cleanText, getLocation, sendmessage).

if (!function_exists('dbg')) {
    function dbg(string $msg): void {
        if (function_exists('xhe_log')) { xhe_log('orders', $msg); return; }
        echo date("Y-m-d H:i:s") . " | " . $msg . "<br>";
    }
}

// --- Telegram notify filters (per-account) ---
if (!function_exists('findAccountByChatId')) {
    function findAccountByChatId($chatId) {
        $c = cfg();
        if (!isset($c['jetinno']['accounts']) || !is_array($c['jetinno']['accounts'])) return null;

        // Try match by telegram_chat_id if provided
        if ($chatId !== null && $chatId !== '') {
            foreach ($c['jetinno']['accounts'] as $acc) {
                if ((string)($acc['telegram_chat_id'] ?? '') === (string)$chatId) return $acc;
            }
        }

        // Fallback to first account (legacy single-account setups)
        return $c['jetinno']['accounts'][0] ?? null;
    }
}

if (!function_exists('isTelegramNotifyEnabledAcc')) {
    function isTelegramNotifyEnabledAcc($acc, $type) {
        if (!$acc || !is_array($acc)) return true; // keep backward compatibility
        if (!isset($acc['telegram_notify']) || !is_array($acc['telegram_notify'])) return true;
        return (bool)($acc['telegram_notify'][$type] ?? true);
    }
}


/**
 * Get cell value by exact data-title.
 * Supports <a data-title="X">VALUE</a> and <td data-title="X">VALUE</td>.
 */
if (!function_exists('extractByDataTitleExact')) {
    function extractByDataTitleExact(string $rowHtml, string $title): string
    {
        $t = preg_quote($title, '~');

        // <a ... data-title="X">VALUE</a>
        if (preg_match('~<a[^>]*\bdata-title\s*=\s*"' . $t . '"[^>]*>(.*?)</a>~uis', $rowHtml, $m)) {
            return cleanText($m[1]);
        }

        // <td ... data-title="X">VALUE</td>
        if (preg_match('~<td[^>]*\bdata-title\s*=\s*"' . $t . '"[^>]*>(.*?)</td>~uis', $rowHtml, $m2)) {
            return cleanText($m2[1]);
        }

        return '';
    }
}

/** Try multiple data-title labels until value found */
if (!function_exists('extractByTitles')) {
    function extractByTitles(string $rowHtml, array $titles): string
    {
        foreach ($titles as $t) {
            $v = extractByDataTitleExact($rowHtml, $t);
            if ($v !== '') return $v;
        }
        return '';
    }
}

/** Extract OrderNo from <td class="order_no">...</td> */
if (!function_exists('extractOrderNo')) {
    function extractOrderNo(string $rowHtml): string
    {
        if (preg_match('~<td[^>]*class="[^"]*\border_no\b[^"]*"[^>]*>\s*([0-9]{10,})\s*</td>~si', $rowHtml, $m)) {
            return trim($m[1]);
        }
        // fallback: any long numeric token starting with 20...
        if (preg_match('~\b(20\d{10,26})\b~', $rowHtml, $m2)) {
            return trim($m2[1]);
        }
        return '';
    }
}

/** Extract VMC from <a class="... vmc_no ...">81935</a> or from href */
if (!function_exists('extractVmcNo')) {
    function extractVmcNo(string $rowHtml): string
    {
        if (preg_match('~<a[^>]*class="[^"]*\bvmc_no\b[^"]*"[^>]*>(\d{3,10})</a>~si', $rowHtml, $m)) {
            return trim($m[1]);
        }
        if (preg_match('~vmc_no=(\d{3,10})~i', $rowHtml, $m2)) {
            return trim($m2[1]);
        }
        return '';
    }
}

if (!function_exists('loadKnownOrderIds')) {
    function loadKnownOrderIds(string $filePath): array
    {
        if (!file_exists($filePath)) return [];
        $lines = file($filePath, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
        $set = [];
        foreach ($lines as $line) {
            $id = trim($line);
            if ($id !== '') $set[$id] = true;
        }
        return $set;
    }
}

if (!function_exists('appendOrderIds')) {
    function appendOrderIds(string $filePath, array $orderIds): void
    {
        if (empty($orderIds)) return;

        $dir = dirname($filePath);
        if (!is_dir($dir)) @mkdir($dir, 0777, true);

        $fh = @fopen($filePath, "a");
        if (!$fh) {
            dbg("Orders ERROR: cannot open store file: {$filePath}");
            return;
        }

        foreach ($orderIds as $id) {
            fwrite($fh, $id . PHP_EOL);
        }
        fclose($fh);
    }
}

/** Normalize price text to float-like number (keeps dot) */
if (!function_exists('normalizePrice')) {
    function normalizePrice(string $priceText): float
    {
        // "0.00", "35,00", "35 TL", etc.
        $p = trim($priceText);
        $p = str_replace(',', '.', $p);
        $p = preg_replace('~[^0-9\.]+~', '', $p);
        if ($p === '' || $p === '.') return 0.0;
        return (float)$p;
    }
}

/** Decide if payType/price indicates free order */
if (!function_exists('isFreeOrder')) {
    function isFreeOrder(string $payType, float $price): bool
    {
        if ($price <= 0.00001) return true;

        $pt = mb_strtolower($payType, 'UTF-8');
        // Turkish / English common variants
        if (str_contains($pt, 'ücretsiz') || str_contains($pt, 'ucretsiz')) return true; // Ücretsiz kupa
        if (str_contains($pt, 'free')) return true; // For Free
        if (str_contains($pt, 'gift')) return true;

        return false;
    }
}

/**
 * Main checker.
 * - Reads HTML from $webpage->get_body()
 * - Sends TG for new orders (non-free)
 * - Stores orderNo in txt for dedupe
 */
if (!function_exists('checkNewMdbOrders_TR')) {
    function checkNewMdbOrders_TR(
        $webpage,
        array $locations,
        string $storeFilePath,
        string $debugHtmlPath = "c:\debug_order_page.html",
        bool $skipFreeOrders = true,
        $chatId = null,
        $account = null,
        string $accountKey = '',
        ?bool $tgEnabled = null
    ): void
    {
        dbg("Orders: reading HTML via \$webpage->get_body() ...");
        $html = $webpage->get_body();

        if ($html === null || $html === false || trim((string)$html) === "") {
            dbg("Orders ERROR: HTML body is EMPTY (page not loaded / redirected).");
            return;
        }

        @file_put_contents($debugHtmlPath, $html);
        dbg("Orders: saved HTML to: {$debugHtmlPath}");
        dbg("Orders: HTML length: " . strlen($html));

        $htmlDecoded = html_entity_decode($html, ENT_QUOTES);

        $known = loadKnownOrderIds($storeFilePath);
        dbg("Orders: known order IDs: " . count($known));

        preg_match_all('~<tr[^>]*>.*?</tr>~si', $htmlDecoded, $rows);
        $rowCount = isset($rows[0]) ? count($rows[0]) : 0;
        dbg("Orders: found <tr> rows: {$rowCount}");

        if ($rowCount === 0) {
            dbg("Orders ERROR: no <tr> rows found. Open debug HTML.");
            return;
        }

        $newIdsToSave = [];
        $sent = 0;
        $skippedKnown = 0;
        $skippedFree = 0;
        $badRows = 0;

        foreach ($rows[0] as $rowHtml) {

            // orderNo for dedupe
            $orderNo = extractOrderNo($rowHtml);
            if ($orderNo === '') continue;

            if (isset($known[$orderNo])) {
                $skippedKnown++;
                continue;
            }

            // machine
            $vmcNo = extractVmcNo($rowHtml);
            if ($vmcNo === '') {
                // can't use it without machine, mark processed to avoid endless repeats
                $known[$orderNo] = true;
                $newIdsToSave[] = $orderNo;
                continue;
            }

            $vmcInt = (int)$vmcNo;
            $location = getLocation($locations, $vmcInt);
            if ($location === null || $location === '') {
                // fallback: TR address title
                $location = extractByTitles($rowHtml, ['Address', 'Cihaz adresi']);
                if ($location === '') $location = 'Unknown';
            }

            // fields: EN + TR variants
            $drinkName = extractByTitles($rowHtml, ['Name', 'Product Name', 'Ürün adı']);
            $priceText = extractByTitles($rowHtml, ['Price', 'Amount', 'Ürün fiyatı']);
            $payType   = extractByTitles($rowHtml, ['Pay Type', 'Payment Type', 'Ödeme türü']);

            $price = normalizePrice($priceText);

            // Free orders: silently skip (but mark processed)
            if ($skipFreeOrders && isFreeOrder($payType, $price)) {
                dbg("Orders: skipped FREE order | VMC {$vmcNo} - {$location} | {$drinkName} | price={$priceText} | pay={$payType}");
                $known[$orderNo] = true;
                $newIdsToSave[] = $orderNo;
                $skippedFree++;
                continue;
            }

            // If still missing key fields -> save bad row for analysis
            if ($drinkName === '' || $priceText === '' || $payType === '') {
                $badRows++;
                @file_put_contents("c:\\debug_bad_row_{$orderNo}.html", $rowHtml);
                dbg("Orders: bad row (missing fields) saved: c:\\debug_bad_row_{$orderNo}.html");
                // mark processed to avoid repeating spam
                $known[$orderNo] = true;
                $newIdsToSave[] = $orderNo;
                continue;
            }

            // Compose message WITHOUT orderNo (as requested)
            $msg =
                "NEW ORDER | {$payType}\n" .
                "VMC: {$vmcNo} - {$location}\n" .
                "{$drinkName}\n" .
                "Price: {$priceText}";

            dbg("Orders NEW | {$payType} | {$vmcNo} - {$location} | {$drinkName} | Price: {$priceText}");
            // Per-account filter: allow disabling orders per account via config.php 'telegram_notify' => ['orders' => false]
            // Per-account filter: allow disabling orders per account via config.php 'telegram_notify' => ['orders' => false]
            $acc = (is_array($account) ? $account : findAccountByChatId($chatId));
            $enabled = ($tgEnabled === null) ? true : (bool)$tgEnabled;
            if (!$enabled) {
                dbg("Orders notify disabled (tgEnabled=false); skip Telegram.");
            } elseif ($acc && !isTelegramNotifyEnabledAcc($acc, 'orders')) {
                dbg("Orders notify disabled in config for this account; skip Telegram.");
            } else {
                $k = ($accountKey !== '' ? ($accountKey . '|' . (string)$orderNo) : (string)$orderNo);
                tg_notify('orders', $msg, $chatId, $k);
            }
            // Mark processed
            $known[$orderNo] = true;
            $newIdsToSave[] = $orderNo;
            $sent++;
        }

        appendOrderIds($storeFilePath, $newIdsToSave);

        dbg("Orders STATS: sent={$sent}, skippedFree={$skippedFree}, knownSkipped={$skippedKnown}, badRows={$badRows}, savedNewIds=" . count($newIdsToSave) . " -> {$storeFilePath}");
    }
}

?>