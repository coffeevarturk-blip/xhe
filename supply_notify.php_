<?php
// supply_notify.php
// ВАЖНО: здесь НЕТ require_once functions.php — подключаем всё централизованно в all_in_one.php

if (!function_exists('dbg')) {
    function dbg(string $msg): void {
        if (function_exists('log_debug')) { log_debug('supply', $msg); return; }
        if (function_exists('xhe_log')) { xhe_log('supply', $msg, 'DEBUG'); return; }
        echo date("Y-m-d H:i:s") . " | " . $msg . "<br>";
    }
}

/**
 * Уведомления о низких остатках (Supply List).
 *
 * Пишем антиспам только в:
 *   $state['supplies_alert'][$accountKey][$deviceId][$key] = timestamp
 */
function notifyLowSupplies(
    array $parsedData,
    array $locations,
    array &$state,
    int $antispamSeconds = 3600,
    string $group = 'supplies_alert',
    string $accountKey = 'default',
    $chatId = null
): void
{
    dbg("notifyLowSupplies() CALLED | rows=" . count($parsedData));

    $thresholdsByKey = [
        'tea'       => 200,
        'chocolate' => 500,
        'milk'      => 500,
        'syrup'     => 200,
        'water'     => 19,
        'coffee'    => 1000,
    ];

    foreach ($parsedData as $row) {
        $deviceId = (int)($row['device_id'] ?? 0);
        if ($deviceId <= 0) continue;

        // берём локацию из вашего массива, иначе fallback на address из парсинга
        $location = getLocation($locations, $deviceId) ?: (($row['address'] ?? '') ?: 'Unknown');

        $supplies = $row['supplies'] ?? null;
        if (!is_array($supplies)) continue;

        foreach ($supplies as $supplyId => $s) {
            $rawName = trim((string)($s['name'] ?? ''));
            $name    = mb_strtolower($rawName, 'UTF-8');
            $value   = (int)($s['value'] ?? 0);

            if ($rawName === '') continue;

            $key = null;

            if (str_contains($name, 'çay') || str_contains($name, 'tea')) $key = 'tea';
            elseif (str_contains($name, 'çikol') || str_contains($name, 'choco') || str_contains($name, 'kakao')) $key = 'chocolate';
            elseif (str_contains($name, 'süt') || str_contains($name, 'milk')) $key = 'milk';
            elseif (str_contains($name, 'şurup') || str_contains($name, 'syrup')) $key = 'syrup';
            elseif ($name === 'su' || str_contains($name, ' su ') || str_contains($name, 'water')) $key = 'water';
            elseif (str_contains($name, 'kahve') || str_contains($name, 'bean') || str_contains($name, 'coffee')) $key = 'coffee';

            if ($key === null) continue;

            $limit = $thresholdsByKey[$key] ?? null;
            if ($limit === null) continue;

            dbg("MATCH acc={$accountKey} | dev={$deviceId} | {$location} | key={$key} | name={$rawName} | val={$value} | limit={$limit}");

            // антиспам per device + per key
            $path = [$group, $accountKey, $deviceId, $key];
            if (!state_can_send($state, $path, $antispamSeconds, false)) {
                $last = state_get_ts($state, $path, 0);
                dbg("SKIP by antispam acc={$accountKey} dev={$deviceId} key={$key} last={$last}");
                continue;
            }

            if ($value <= $limit) {
                // ✅ FIX: используем $supplyId, а не $sid
                $msg = "LOW SUPPLY | {$deviceId} - {$location}\n{$rawName} (ID {$supplyId}) = {$value} ≤ {$limit}";
                $chat = ($chatId === null) ? 'null' : (string)$chatId;
                dbg("SEND TG acc={$accountKey} chat_id={$chat}: " . str_replace("\n"," | ",$msg));
                tg_notify('supply', $msg, $chatId, $accountKey.'|'.$deviceId.'|'.$supplyId, $state);
                state_set_ts($state, $path, time());
            } else {
                dbg("OK dev={$deviceId} key={$key} val={$value} > {$limit}");
            }
        }
    }
}
